<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MindaFresh | Employee Attendance Kiosk</title>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #ffeadc;
      color: #382117;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 25px;
    }
    .kiosk-container {
      width: 100%;
      max-width: 920px;
      background: #fffaf6;
      border: 1px solid #f1d6c6;
      border-radius: 24px;
      box-shadow: 0 15px 45px rgba(103, 53, 27, 0.08);
      padding: 40px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 30px;
    }
    .brand img {
      width: 42px;
      height: 42px;
      object-fit: contain;
    }
    .brand strong {
      font-size: 22px;
    }
    .brand span {
      color: #d43c00;
      font-size: 13px;
      border-left: 1px solid #efbda7;
      padding-left: 12px;
    }
    .badge {
      display: inline-block;
      background: #e0f5e8;
      color: #137b42;
      padding: 8px 14px;
      border-radius: 30px;
      font-size: 12px;
      margin-bottom: 16px;
    }
    .clock {
      font-size: clamp(40px, 8vw, 65px);
      font-weight: 800;
      letter-spacing: -2px;
    }
    .clock small {
      font-size: 22px;
      color: #a53b14;
      letter-spacing: 0;
    }
    .date {
      margin: 8px 0 30px;
      color: #825d4b;
      font-size: 14px;
    }
    h1 {
      font-size: 25px;
      margin-bottom: 8px;
    }
    .subtitle {
      font-size: 14px;
      color: #805b4a;
      margin-bottom: 25px;
    }
    label {
      display: block;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 8px;
    }
    input {
      width: 100%;
      padding: 15px;
      border: 1px solid #efcbb7;
      border-radius: 10px;
      font-size: 15px;
      outline: none;
      background: white;
    }
    input:focus {
      border-color: #d43c00;
    }
    button {
      cursor: pointer;
      font-size: 14px;
      font-weight: bold;
      border-radius: 10px;
      padding: 13px 18px;
      transition: background 0.2s;
    }
    #qr-reader {
      width: 100%;
      max-width: 450px;
      margin: 15px auto;
      border-radius: 12px;
      overflow: hidden;
    }
    #qr-status {
      font-size: 13px;
      color: #8b5941;
      margin-bottom: 15px;
      overflow-wrap: anywhere;
    }
    .punch-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin: 25px 0;
    }
    .punch-card {
      background: white;
      border: 1px solid #efcfbd;
      border-radius: 12px;
      padding: 18px;
    }
    .punch-card strong {
      display: block;
      font-size: 14px;
      margin-bottom: 5px;
    }
    .punch-card small {
      color: #855f4b;
      font-size: 12px;
    }
    .submit-btn {
      width: 100%;
      background: #d43c00;
      color: white;
      border: none;
      padding: 17px;
      margin-top: 5px;
    }
    .submit-btn:hover {
      background: #b83200;
    }
    .work-hours {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid #efd6c8;
    }
    .work-hours strong {
      display: block;
      margin-bottom: 6px;
    }
    .work-hours small {
      color: #805b4a;
    }
    .back-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      min-height: 58px;
      margin-top: 24px;
      padding: 16px 20px;
      background: #fff0e6;
      border: 2px solid #d43c00;
      border-radius: 12px;
      color: #bc3500;
      font-size: 16px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }
    .back-link:hover {
      background: #d43c00;
      color: #fff;
    }
    .back-link:focus-visible {
      outline: 3px solid #ff9d70;
      outline-offset: 3px;
    }
    .back-link .back-arrow {
      font-size: 22px;
      line-height: 1;
    }
    .notice {
      padding: 13px;
      background: #e8f7ed;
      border-radius: 10px;
      color: #176638;
      margin: 15px 0;
    }
    .error {
      padding: 13px;
      background: #fff0ec;
      border-radius: 10px;
      color: #ae2900;
      margin: 15px 0;
    }
    [hidden] {
      display: none !important;
    }
    @media (max-width: 600px) {
      .kiosk-container {
        padding: 22px;
      }
      .punch-grid {
        grid-template-columns: 1fr;
      }
      .brand strong {
        font-size: 18px;
      }
    }
  </style>
</head>
<body>
  <main class="kiosk-container">
    <div class="brand">
      <img src="/mindafresh-logo.png" alt="MindaFresh Logo">
      <strong>MindaFresh</strong>
      <span>Attendance ERP</span>
    </div>
    <div class="badge">
      ● Employee Attendance Kiosk
    </div>
    <div class="clock" id="clock">
      --:--:-- <small>AM</small>
    </div>
    <div class="date" id="date">
      Loading date...
    </div>
    <h1>Employee QR Attendance</h1>
    <p class="subtitle">
      Scan your employee QR code using the laptop camera
      or enter your employee code manually.
    </p>
    {{#if message}}
      <div class="notice">{{message}}</div>
    {{/if}}
    {{#if error}}
      <div class="error">{{error}}</div>
    {{/if}}
    {{#if employee}}
      <div class="notice">
        {{employee.first_name}} {{employee.last_name}}
        · Next: <strong>{{action}}</strong>
      </div>
    {{/if}}
    <form
      action="/kiosk/punch"
      method="POST"
      id="punch-form"
    >
      <label for="employee-code">
        EMPLOYEE CODE
      </label>
      <input
        type="text"
        id="employee-code"
        name="code"
        placeholder="Enter or scan your employee code"
        value="{{#if employee}}{{employee.employee_code}}{{/if}}"
        autocomplete="off"
        required
      >
      <div id="qr-status" role="status" aria-live="polite">
        Starting camera automatically...
      </div>
      <div id="qr-reader"></div>
      <div class="punch-grid">
        <div class="punch-card">
          <strong>☀ AM In</strong>
          <small>Starts 8:00 AM</small>
        </div>
        <div class="punch-card">
          <strong>↗ AM Out</strong>
          <small>Lunch 12:00 PM</small>
        </div>
        <div class="punch-card">
          <strong>◒ PM In</strong>
          <small>Resumes 1:00 PM</small>
        </div>
        <div class="punch-card">
          <strong>↗ PM Out</strong>
          <small>Ends 5:00 PM</small>
        </div>
      </div>
      <button class="submit-btn" type="submit">
        Record Attendance Manually →
      </button>
    </form>
    <div class="work-hours">
      <strong>◷ Work Hours</strong>
      <small>
        8:00 AM – 12:00 PM · 1:00 PM – 5:00 PM
      </small>
    </div>
    <a href="/login" class="back-link">
      <span class="back-arrow" aria-hidden="true">←</span> Back to HR/Admin Login
    </a>
  </main>

  <script>
    // LIVE CLOCK
    function updateClock() {
      const now = new Date();
      const time = now.toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      });
      const parts = time.split(' ');
      document.getElementById('clock').innerHTML =
        parts[0] + ' <small>' + parts[1] + '</small>';
      document.getElementById('date').textContent =
        now.toLocaleDateString('en-US', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
    }
    updateClock();
    setInterval(updateClock, 1000);
    // DIRECT SUBMISSION — NO CONFIRMATION MODAL
    const form = document.getElementById('punch-form');
    const codeInput = document.getElementById('employee-code');
    const readerElement = document.getElementById('qr-reader');
    const status = document.getElementById('qr-status');
    const submitBtn = form.querySelector('button[type="submit"]');

    let scanner = null;
    let isSubmitting = false;
    const SCAN_COOLDOWN_MS = 15000;
    const SCAN_KEY = 'mindafresh-kiosk-last-qr';

    function recentlyScanned(code) {
      try {
        const last = JSON.parse(sessionStorage.getItem(SCAN_KEY) || 'null');
        return last && last.code === code &&
          Date.now() - last.time < SCAN_COOLDOWN_MS;
      } catch (_) {
        return false;
      }
    }

    function rememberScan(code) {
      try {
        sessionStorage.setItem(SCAN_KEY, JSON.stringify({
          code, time: Date.now()
        }));
      } catch (_) {}
    }

    form.addEventListener('submit', (event) => {
      if (isSubmitting) {
        event.preventDefault();
        return;
      }
      const code = codeInput.value.trim();
      if (!code) {
        event.preventDefault();
        codeInput.focus();
        return;
      }
      codeInput.value = code;
      isSubmitting = true;
      submitBtn.disabled = true;
      status.textContent = 'Recording attendance...';
      // Native POST to /kiosk/punch; server decides the next valid punch.
    });

    async function startCameraAutomatically() {
      if (typeof Html5Qrcode === 'undefined') {
        status.textContent = 'QR scanner library unavailable. Check your internet connection or enter your code manually.';
        return;
      }
      if (!navigator.mediaDevices?.getUserMedia) {
        status.textContent = 'Camera requires localhost or HTTPS. You can still enter your code manually.';
        return;
      }

      status.textContent = 'Opening camera automatically...';
      try {
        scanner = new Html5Qrcode('qr-reader');
        await scanner.start(
          { facingMode: 'user' },
          { fps: 10, qrbox: { width: 220, height: 220 } },
          (decodedText) => {
            if (isSubmitting) return;
            const code = String(decodedText || '').trim();
            if (!code || code.length > 100) {
              status.textContent = 'Invalid QR code. Please try again.';
              return;
            }
            if (recentlyScanned(code)) {
              status.textContent = 'This QR was scanned recently. Please wait before scanning it again.';
              return;
            }
            rememberScan(code);
            codeInput.value = code;
            // Submit immediately; no confirmation dialog or button click.
            form.requestSubmit();
          },
          () => {}
        );
        status.textContent = 'Camera ready. Show your employee QR code.';
      } catch (error) {
        status.textContent = 'Camera could not start: ' +
          (error?.message || String(error)) +
          '. Allow camera access or enter your code manually.';
      }
    }

    window.addEventListener('pagehide', () => {
      if (scanner) {
        try { scanner.stop().catch(() => {}); } catch (_) {}
      }
    });

    startCameraAutomatically();
  </script>
</body>
</html>
