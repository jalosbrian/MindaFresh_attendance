<style>
  /* Layout: use the full width next to the sidebar */
  main.max-w-5xl{max-width:1320px}
  .st{display:inline-block;padding:3px 11px;border-radius:999px;font-size:12px;font-weight:700}
  .st-present{background:#DCFCE7;color:#166534}.st-late{background:#FEF3C7;color:#92400E}
  .st-absent{background:#FEE2E2;color:#991B1B}.st-on_leave{background:#E0F2FE;color:#075985}
  /* Page header, sections, stat cards */
  .ph{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:24px}
  .ph h1{font-size:28px;font-weight:800;line-height:1.1}.ph p{font-size:14px;color:#7A5A47;margin-top:4px}
  .ph-act{display:flex;align-items:center;gap:8px}.ph-act .field{width:auto}
  .sec{font-size:16px;font-weight:700;margin:28px 0 12px}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .stat{background:#fff;border:1px solid #F3DCC8;border-radius:18px;padding:18px 20px;border-left:6px solid var(--c)}
  .stat span{display:block;font-size:13px;font-weight:600;color:#7A5A47}
  .stat b{display:block;font-size:36px;font-weight:800;line-height:1.1;margin-top:4px}
  .s-present{--c:#16A34A}.s-late{--c:#D97706}.s-absent{--c:#DC2626}.s-on_leave{--c:#0284C7}
  /* Tables */
  .tw{overflow-x:auto;padding:0}
  .tbl{width:100%;border-collapse:collapse;font-size:14px}
  .tbl th{text-align:left;padding:12px 16px;background:#FFE2C7;color:#2A1A12;font-weight:700;font-size:12px;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}
  .tbl td{padding:12px 16px;border-top:1px solid #FBEBDC;vertical-align:middle}
  .tbl tbody tr:hover{background:#FFF7EF}
  .tbl .sub{display:block;font-size:12px;color:#7A5A47}
  .tbl .num{text-align:right;white-space:nowrap}.tbl .t{white-space:nowrap}
  .tbl .rm{max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#7A5A47}
  .tbl .empty{text-align:center;padding:36px;color:#7A5A47}
  a.act{display:inline-block;padding:5px 14px;border:1px solid #C2410C;border-radius:999px;font-size:13px;font-weight:700;color:#C2410C;white-space:nowrap}
  a.act:hover{background:#C2410C;color:#fff}
  .filters{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px;padding:16px 20px;margin-bottom:20px}
  .filters>div{flex:0 1 220px}.filters .btn-primary{flex:0 0 auto} /* FIX: filter fields no longer stretch */
  @media (max-width:1024px){.stats{grid-template-columns:repeat(2,1fr)}}
  /* Sidebar */
  body{padding-left:248px}
  .sb{position:fixed;top:0;left:0;bottom:0;width:248px;background:#2A1A12;color:#F3DCC8;display:flex;flex-direction:column;padding:20px 14px;overflow-y:auto;z-index:20}
  .sb-brand{display:block;padding:4px 10px 18px;text-decoration:none}
  .sb-brand b{display:block;font-size:20px;font-weight:800;color:#fff;line-height:1.1}.sb-brand span{font-size:12px;color:#E7C9AE}
  .sb-label{margin:18px 10px 6px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#B99677}
  .sb a.sb-link{display:block;padding:10px 12px;margin-bottom:2px;border-radius:12px;font-size:14px;font-weight:600;color:#F3DCC8;text-decoration:none}
  .sb a.sb-link:hover{background:rgba(255,255,255,.08)}.sb a.sb-link.on{background:#C2410C;color:#fff}
  .sb-user{margin-top:auto;padding:14px 10px 0;border-top:1px solid rgba(255,255,255,.12);font-size:13px}
  .sb-user a{color:#fff;font-weight:700;text-decoration:none}
  @media (max-width:767px){
    body{padding-left:0}.stats{grid-template-columns:1fr 1fr}
    .sb{position:static;width:auto;flex-direction:row;flex-wrap:wrap;align-items:center;gap:4px;padding:10px 12px}
    .sb-brand{padding:0 10px 0 0}.sb-label{display:none}.sb-user{margin:0 0 0 auto;padding:0;border:0}
  }
  /* Log out confirmation */
  .lo{position:fixed;inset:0;background:rgba(42,26,18,.55);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px}
  .lo[hidden]{display:none}
  .lo-box{background:#fff;border-radius:20px;padding:26px;width:100%;max-width:380px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
  .lo-box h2{font-size:20px;font-weight:800}.lo-box p{margin:8px 0 22px;color:#7A5A47;font-size:14px}
  .lo-act{display:flex;gap:10px}.lo-act>*{flex:1;display:flex;align-items:center;justify-content:center;height:44px;padding:0;cursor:pointer} /* FIX: equal buttons */
</style>

<aside class="sb">
  <a href="/kiosk" class="sb-brand"><b>Attendance</b><span>by MindaFresh</span></a>
  <div class="sb-label">Employee</div>
  <a href="/kiosk" class="sb-link {{#if nav.kiosk}}on{{/if}}">Time in / out</a>
  {{#if user}}<a href="/my-logs" class="sb-link {{#if nav.mylogs}}on{{/if}}">My logs</a>{{/if}}
  {{#if isStaff}}
    <div class="sb-label">HR / Admin</div>
    <a href="/dashboard" class="sb-link {{#if nav.dashboard}}on{{/if}}">Dashboard</a>
    <a href="/logs" class="sb-link {{#if nav.logs}}on{{/if}}">Attendance logs</a>
    <a href="/summary" class="sb-link {{#if nav.summary}}on{{/if}}">Summary</a>
  {{/if}}
  <div class="sb-user">
    {{#if user}}
      <div style="color:#fff;font-weight:700">{{user.full_name}}</div>
      <div style="color:#B99677;margin-bottom:8px">{{user.employee_code}}</div>
      <a href="/logout" id="lo-open">Log out</a>
    {{else}}
      <a href="/login">Staff login</a>
    {{/if}}
  </div>
</aside>

<div class="mx-auto w-full max-w-5xl px-6 pt-4" style="max-width:1320px">
  {{#each success_msg}}<div class="mb-3 rounded-xl px-4 py-3 text-sm font-semibold" style="background:#DCFCE7;color:#166534">{{this}}</div>{{/each}}
  {{#each error_msg}}<div class="mb-3 rounded-xl px-4 py-3 text-sm font-semibold" style="background:#FEE2E2;color:#991B1B">{{this}}</div>{{/each}}
</div>

<div id="lo" class="lo" hidden>
  <div class="lo-box" role="dialog" aria-modal="true" aria-labelledby="lo-t">
    <h2 id="lo-t">Log out?</h2>
    <p>Are you sure you want to log out?</p>
    <div class="lo-act">
      <button type="button" id="lo-cancel" class="btn-outline">Cancel</button>
      <a href="/logout" class="btn-primary">Yes, log out</a>
    </div>
  </div>
</div>
<script>
  (function () {
    var box = document.getElementById("lo"), open = document.getElementById("lo-open");
    if (!box || !open) return;
    function show(v) { box.hidden = !v; }
    open.addEventListener("click", function (e) { e.preventDefault(); show(true); });
    document.getElementById("lo-cancel").addEventListener("click", function () { show(false); });
    box.addEventListener("click", function (e) { if (e.target === box) show(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") show(false); });
  })();
</script>